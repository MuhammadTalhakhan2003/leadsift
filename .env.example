# Optional AI scoring (summaries, fit score, outreach openers). Without a key the
# app runs on the transparent rules-based score only. If both keys are set, Claude
# is used unless AI_PROVIDER=groq.

# Free: create a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=

# AI_PROVIDER=groq   # groq | claude | none

# Optional. Neon (or any) Postgres connection string for the shared page/lead cache.
# Without it an in-memory cache is used (fine for local dev, per-instance on Vercel).
DATABASE_URL=
